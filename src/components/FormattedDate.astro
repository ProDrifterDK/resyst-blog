---
interface Props {
	date: Date;
	lang?: 'es' | 'en';
}

const { date, lang = 'es' } = Astro.props;
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString(lang === 'es' ? 'es-CL' : 'en-US', {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
			// Content dates are calendar dates, not instants: format in UTC so a
			// negative local offset never shifts them to the previous day.
			timeZone: 'UTC',
		})
	}
</time>
