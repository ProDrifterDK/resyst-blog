---
import { SITE_TITLE } from '../consts';

// Normalize: strip leading/trailing slashes, root becomes '/'
const pathname = Astro.url.pathname
	.replace(import.meta.env.BASE_URL, '')
	.replace(/^\/+|\/+$/g, '') || '/';

const links = [
	{ href: '/', label: 'Inicio' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/blog/tags', label: 'Tags' },
	{ href: '/about', label: 'Sobre mí' },
];

// Find the best (most specific) matching link using prefix matching.
// Exact match always wins. Among prefix matches, longest href wins.
function getActiveIndex(pn: string, items: { href: string }[]): number {
	let bestIdx = -1;
	let bestLen = -1;

	for (let i = 0; i < items.length; i++) {
		const hn = items[i].href.replace(/^\/+|\/+$/g, '') || '/';

		if (hn === pn) {
			return i; // exact match is always best
		}

		// prefix match: "blog/some-post/" starts with "blog/"
		if ((pn + '/').startsWith(hn + '/') && hn.length > bestLen) {
			bestIdx = i;
			bestLen = hn.length;
		}
	}

	return bestIdx;
}

const activeIdx = getActiveIndex(pathname, links);
---

<header>
	<nav>
		<div class="logo">
			<a href="/">
				<img src="/logo.png" alt="Resyst" class="logo-img" />
				<span class="logo-text">{SITE_TITLE}</span>
			</a>
		</div>
		<div class="nav-links">
			{links.map((link, idx) => (
				<a href={link.href} class:list={[{ active: idx === activeIdx }]}>
					{link.label}
				</a>
			))}
		</div>
		<div class="social-links">
			<a href="https://github.com/ProDrifterDK" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22">
					<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		margin: 0;
		padding: 0 2em;
		background: rgba(8, 8, 15, 0.85);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-bottom: 1px solid var(--border);
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: var(--max-width-wide);
		margin: 0 auto;
		height: 60px;
	}

	.logo a {
		display: flex;
		align-items: center;
		gap: 0.5em;
		text-decoration: none;
		color: var(--text-heading);
		font-family: var(--font-serif);
		font-size: 1.15em;
		font-weight: 500;
		transition: opacity var(--transition-fast);
	}

	.logo a:hover {
		opacity: 0.85;
		text-decoration: none;
	}

	.logo-img {
		width: 36px;
		height: 36px;
		object-fit: contain;
		border-radius: 4px;
	}

	.logo-icon {
		font-size: 1.3em;
	}

	.nav-links {
		display: flex;
		gap: 0.25em;
	}

	.nav-links a {
		padding: 0.5em 0.9em;
		color: var(--text-secondary);
		border-bottom: 2px solid transparent;
		text-decoration: none;
		font-size: 0.92em;
		font-weight: 500;
		transition: color var(--transition-fast), border-color var(--transition-fast);
		border-radius: 4px 4px 0 0;
	}

	.nav-links a:hover {
		color: var(--text-heading);
		text-decoration: none;
	}

	.nav-links a.active {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}

	.social-links {
		display: flex;
	}

	.social-links a {
		color: var(--text-muted);
		display: flex;
		align-items: center;
		padding: 0.4em;
		transition: color var(--transition-fast);
	}

	.social-links a:hover {
		color: var(--accent);
		text-decoration: none;
	}

	@media (max-width: 720px) {
		header {
			padding: 0 1em;
		}

		.social-links {
			display: none;
		}

		.logo-text {
			display: none;
		}

		.nav-links {
			gap: 0;
		}

		.nav-links a {
			font-size: 0.88em;
			padding: 0.5em 0.6em;
		}
	}
</style>
