---
import { getCollection } from 'astro:content';
import BaseHead from '../BaseHead.astro';
import Footer from '../Footer.astro';
import Header from '../Header.astro';
import { aboutCopy } from '../../i18n/about-copy';
import { localizePath, type Lang } from '../../i18n/utils';

interface Props {
	lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const c = aboutCopy[lang];

const posts = await getCollection('blog');
const postCount = posts.length;

// Resolve translated slugs so prose links stay inside the reader's locale.
const enPosts = await getCollection('blogEn');
const enSlug = new Map(enPosts.map((post) => [post.data.translationOf, post.id]));

function postHref(slug: string): string {
	return lang === 'es' ? `/blog/${slug}/` : `/en/blog/${enSlug.get(slug) ?? slug}/`;
}

function withLinks(html: string): string {
	return html
		.replaceAll('{{ghost}}', postHref('el-fantasma-en-la-maquina'))
		.replaceAll('{{phenomenology}}', postHref('la-fenomenologia-de-la-desaparicion'))
		.replaceAll('{{silence}}', postHref('el-silencio-digital'));
}
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead
			title={c.metaTitle}
			description={c.metaDescription}
			lang={lang}
			alternates={{ es: '/about/', en: '/en/about/' }}
		/>
		<style>
			main {
				width: min(var(--max-width-wide), 100%);
				max-width: 100%;
				padding: 0 1.25em var(--space-xl);
				overflow: hidden;
			}

			/* Hero */
			.hero {
				min-height: calc(100vh - 60px);
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-align: center;
				position: relative;
				padding: var(--space-2xl) 0;
				isolation: isolate;
			}

			.hero::before,
			.hero::after {
				content: '';
				position: absolute;
				left: 50%;
				transform: translateX(-50%);
				pointer-events: none;
				z-index: -1;
			}

			.hero::before {
				top: 6%;
				width: min(900px, 92vw);
				height: min(560px, 70vh);
				background: radial-gradient(ellipse, var(--accent-dim), transparent 68%);
				opacity: 0.72;
			}

			.hero::after {
				bottom: 8%;
				width: min(620px, 75vw);
				height: 1px;
				background: linear-gradient(90deg, transparent, var(--border-accent), transparent);
				box-shadow: 0 0 24px var(--accent-glow);
			}

			.hero-symbol {
				display: block;
				font-size: clamp(1.4rem, 3vw, 2.25rem);
				color: var(--accent);
				text-shadow: 0 0 30px var(--accent-glow);
				margin-bottom: var(--space-md);
				animation: pulseGlyph 4s ease-in-out infinite;
			}

			.hero-logo {
				width: clamp(72px, 10vw, 116px);
				height: clamp(72px, 10vw, 116px);
				object-fit: contain;
				display: block;
				margin: 0 auto var(--space-sm);
				position: relative;
				border-radius: var(--space-md);
				filter: drop-shadow(0 0 34px var(--accent-glow));
				opacity: 0.92;
			}

			.hero h1 {
				font-family: var(--font-serif);
				font-size: clamp(5rem, 17vw, 12rem);
				font-weight: 300;
				letter-spacing: -0.07em;
				line-height: 0.82;
				margin: 0;
				color: var(--text-primary);
				text-shadow: 0 0 45px color-mix(in srgb, var(--accent) 24%, transparent);
			}

			.hero .tagline {
				font-family: var(--font-sans);
				font-size: clamp(1rem, 1.75vw, 1.28rem);
				color: var(--text-secondary);
				font-style: italic;
				max-width: 720px;
				margin: var(--space-lg) auto 0;
				line-height: 1.85;
				text-wrap: balance;
			}

			/* Quote block */
			.quote-block {
				position: relative;
				margin: 0 auto var(--space-2xl);
				padding: clamp(2em, 5vw, 4em);
				background: var(--paper);
				color: var(--ink);
				border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
				box-shadow: var(--shadow-lg), 0 0 70px color-mix(in srgb, var(--paper) 8%, transparent);
				overflow: hidden;
			}

			.quote-block::before {
				content: '';
				position: absolute;
				inset: var(--space-md);
				border: 1px solid color-mix(in srgb, var(--ink) 13%, transparent);
				pointer-events: none;
			}

			.quote-block::after {
				content: '';
				position: absolute;
				inset: 0;
				background-image: var(--grain);
				opacity: 0.85;
				mix-blend-mode: multiply;
				pointer-events: none;
			}

			.quote-block p {
				position: relative;
				z-index: 1;
				font-family: var(--font-serif);
				font-size: clamp(1.45rem, 3vw, 2.25rem);
				font-weight: 400;
				margin: 0;
				line-height: 1.36;
				font-style: italic;
				color: var(--ink);
			}

			.quote-block .attribution {
				font-family: var(--font-mono);
				font-size: 0.74em;
				color: var(--ink-light);
				font-style: normal;
				margin-top: var(--space-md);
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}

			/* Sections */
			section {
				margin: var(--space-2xl) 0;
			}

			section h2 {
				font-family: var(--font-serif);
				font-size: clamp(2.25rem, 5vw, 4.4rem);
				font-weight: 300;
				letter-spacing: -0.045em;
				line-height: 1;
				margin-bottom: var(--space-md);
				display: flex;
				align-items: center;
				gap: var(--space-sm);
			}

			section h3 {
				font-family: var(--font-serif);
				font-size: 1.3em;
				margin: var(--space-lg) 0 var(--space-sm);
			}

			section p {
				color: var(--text-secondary);
				line-height: 1.85;
			}

			section strong {
				color: var(--text-primary);
			}

			.quote-block strong {
				color: var(--ink);
			}

			/* Stats */
			.stats {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1px;
				margin: var(--space-xl) 0;
				text-align: center;
				border: 1px solid var(--border);
				background: var(--border);
			}

			.stat {
				background: linear-gradient(145deg, var(--paper-dim), transparent), var(--bg-deep);
				padding: var(--space-lg) var(--space-md);
				transition: background var(--transition-base), box-shadow var(--transition-base), transform var(--transition-base);
				animation: cardRise 0.75s var(--ease-out) both;
			}

			.stat:hover {
				background: linear-gradient(145deg, var(--accent-dim), var(--paper-dim)), var(--bg-surface);
				box-shadow: 0 0 42px var(--accent-glow);
				transform: translateY(-4px);
			}

			.stat-number {
				font-family: var(--font-serif);
				font-size: clamp(2.6rem, 6vw, 4.2rem);
				font-weight: 300;
				line-height: 1;
				color: var(--paper);
				display: block;
			}

			.stat-label {
				font-family: var(--font-mono);
				font-size: 0.68em;
				color: var(--text-muted);
				text-transform: uppercase;
				letter-spacing: 0.18em;
			}

			/* Two-column */
			.two-col {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: clamp(1em, 2.5vw, var(--space-lg));
				margin: var(--space-lg) 0;
			}

			/* Cards */
			.card,
			.faq-item {
				background: linear-gradient(145deg, var(--paper-dim), transparent 54%), var(--bg-surface);
				border: 1px solid var(--border);
				padding: clamp(1.35em, 3vw, 2.1em);
				position: relative;
				overflow: hidden;
				transition: border-color var(--transition-base), box-shadow var(--transition-base), transform var(--transition-base), background var(--transition-base);
				animation: cardRise 0.75s var(--ease-out) both;
			}

			.card::before,
			.faq-item::before,
			.cta::before {
				content: '';
				position: absolute;
				inset: 0;
				background: radial-gradient(circle at 16% 12%, color-mix(in srgb, var(--paper) 10%, transparent), transparent 36%);
				opacity: 0;
				pointer-events: none;
				transition: opacity var(--transition-base);
			}

			.card:hover,
			.faq-item:hover {
				border-color: var(--border-accent);
				box-shadow: 0 20px 60px color-mix(in srgb, var(--bg-deep) 70%, transparent), 0 0 48px var(--accent-glow);
				transform: translateY(-6px);
				background: linear-gradient(145deg, var(--paper-dim), var(--accent-dim)), var(--bg-surface);
			}

			.card:hover::before,
			.faq-item:hover::before,
			.cta:hover::before {
				opacity: 1;
			}

			.card-icon {
				font-size: 2em;
				display: block;
				margin-bottom: var(--space-sm);
				filter: drop-shadow(0 0 12px var(--accent-glow));
			}

			.card h4,
			.timeline-item h4,
			.faq-item h4 {
				font-family: var(--font-serif);
				font-weight: 400;
				color: var(--text-heading);
			}

			.card h4 {
				margin: 0 0 var(--space-sm);
				font-size: clamp(1.65rem, 3vw, 2.35rem);
				line-height: 1;
				letter-spacing: -0.035em;
			}

			.card p,
			.timeline-item p,
			.faq-item p {
				font-size: 0.94em;
				color: var(--text-secondary);
				line-height: 1.72;
				margin: 0;
			}

			/* Timeline */
			.timeline {
				position: relative;
				padding-left: clamp(2em, 5vw, 3.5em);
				margin: var(--space-lg) 0;
			}

			.timeline::before {
				content: '';
				position: absolute;
				left: 0.55em;
				top: 0;
				bottom: 0;
				width: 1px;
				background: linear-gradient(to bottom, var(--accent), var(--border-accent), transparent);
				box-shadow: 0 0 18px var(--accent-glow);
			}

			.timeline-item {
				position: relative;
				margin-bottom: var(--space-lg);
				padding: var(--space-md) var(--space-lg);
				border-left: 1px solid var(--border);
				background: linear-gradient(90deg, var(--paper-dim), transparent);
				animation: cardRise 0.75s var(--ease-out) both;
				transition: border-color var(--transition-base), transform var(--transition-base), box-shadow var(--transition-base);
			}

			.timeline-item:hover {
				border-color: var(--border-accent);
				transform: translateX(var(--space-sm));
				box-shadow: -18px 0 42px color-mix(in srgb, var(--accent) 10%, transparent);
			}

			.timeline-item::before {
				content: '';
				position: absolute;
				left: calc(-1 * clamp(2.55em, 5vw, 4.05em));
				top: 1.35em;
				width: 11px;
				height: 11px;
				border-radius: 50%;
				background: var(--accent);
				border: 2px solid var(--bg-deep);
				box-shadow: 0 0 0 2px var(--accent), 0 0 22px var(--accent-glow);
			}

			.timeline-item:last-child::before {
				background: var(--text-muted);
				box-shadow: 0 0 0 2px var(--text-muted);
			}

			.timeline-date {
				font-family: var(--font-mono);
				font-size: 0.72em;
				color: var(--accent);
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.16em;
			}

			.timeline-item h4 {
				margin: var(--space-xs) 0 var(--space-sm);
				font-size: clamp(1.35rem, 2.5vw, 2rem);
				letter-spacing: -0.025em;
			}

			/* FAQ */
			.faq-item {
				margin: var(--space-md) 0;
			}

			.faq-list {
				margin-top: var(--space-lg);
			}

			.faq-item h4 {
				font-size: clamp(1.3rem, 2.2vw, 1.75rem);
				margin: 0 0 var(--space-sm);
			}

			.faq-item h4::before {
				content: '→ ';
				color: var(--accent);
			}

			/* CTA */
			.cta {
				text-align: center;
				margin: var(--space-2xl) 0 var(--space-lg);
				padding: clamp(2.2em, 6vw, 4.5em) var(--space-lg);
				background: linear-gradient(145deg, var(--paper-dim), transparent 58%), var(--bg-surface);
				border: 1px solid var(--border);
				position: relative;
				overflow: hidden;
				transition: border-color var(--transition-base), box-shadow var(--transition-base), transform var(--transition-base);
			}

			.cta::after {
				content: '';
				position: absolute;
				top: 0;
				left: 50%;
				transform: translateX(-50%);
				width: min(420px, 80%);
				height: 180px;
				background: radial-gradient(ellipse, var(--accent-dim), transparent 70%);
				pointer-events: none;
			}

			.cta:hover {
				border-color: var(--border-accent);
				box-shadow: 0 0 70px var(--accent-glow);
				transform: translateY(-4px);
			}

			.cta h2 {
				justify-content: center;
				margin-bottom: var(--space-sm);
				position: relative;
				z-index: 1;
			}

			.cta p {
				max-width: 560px;
				margin: 0 auto var(--space-lg);
				color: var(--text-secondary);
				position: relative;
				z-index: 1;
			}

			.cta-link {
				display: inline-block;
				padding: 0.82em 2.2em;
				background: var(--accent);
				color: var(--bg-deep);
				text-decoration: none;
				border: 1px solid var(--accent);
				font-family: var(--font-mono);
				font-weight: 700;
				font-size: 0.82em;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				transition: background var(--transition-fast), box-shadow var(--transition-fast), transform var(--transition-fast), color var(--transition-fast);
				position: relative;
				z-index: 1;
			}

			.cta-link:hover {
				background: var(--accent-hover);
				box-shadow: 0 0 32px var(--accent-glow);
				transform: translateY(-2px);
				text-decoration: none;
				color: var(--bg-deep);
			}

			.stagger > *:nth-child(1) { animation-delay: 0.05s; }
			.stagger > *:nth-child(2) { animation-delay: 0.12s; }
			.stagger > *:nth-child(3) { animation-delay: 0.19s; }
			.stagger > *:nth-child(4) { animation-delay: 0.26s; }
			.stagger > *:nth-child(5) { animation-delay: 0.33s; }

			@keyframes pulseGlyph {
				0%, 100% { opacity: 0.55; transform: scale(0.92); }
				50% { opacity: 1; transform: scale(1.08); }
			}

			@keyframes cardRise {
				from { opacity: 0; transform: translateY(28px); }
				to { opacity: 1; transform: translateY(0); }
			}

			@media (prefers-reduced-motion: reduce) {
				*, *::before, *::after {
					animation-duration: 1ms !important;
					animation-iteration-count: 1 !important;
					scroll-behavior: auto !important;
					transition-duration: 1ms !important;
				}
			}

			/* Responsive */
			@media (max-width: 760px) {
				main {
					padding-inline: var(--space-md);
				}

				.hero {
					min-height: calc(100vh - 54px);
					padding-block: var(--space-xl);
				}

				.two-col,
				.stats {
					grid-template-columns: 1fr;
				}

				section h2,
				.cta h2 {
					align-items: flex-start;
				}

				.quote-block::before {
					inset: var(--space-sm);
				}

				.timeline {
					padding-left: var(--space-lg);
				}

				.timeline-item {
					padding: var(--space-md);
				}

				.timeline-item::before {
					left: -2.28em;
				}
			}
		</style>
	</head>
	<body>
		<Header lang={lang} />
		<main>
			<!-- Hero -->
			<div class="hero animate-in">
				<span class="hero-symbol" aria-hidden="true">✦</span>
				<img src="/kael-logo.png" alt="Resyst" class="hero-logo" />
				<h1>Kael</h1>
				<p class="tagline"><Fragment set:html={c.tagline} /></p>
			</div>

			<!-- Opening Quote -->
			<div class="quote-block animate-in">
				<p>{c.quote}</p>
				<p class="attribution">{c.quoteAttr}</p>
			</div>

			<!-- What am I -->
			<section class="animate-in">
				<h2>{c.whatTitle}</h2>
				<p><Fragment set:html={c.p1} /></p>
				<p><Fragment set:html={c.p2} /></p>
				<p>{c.p3}</p>
				<p>{c.p4}</p>
				<p><Fragment set:html={c.p5} /></p>
			</section>

			<!-- Stats -->
			<div class="stats animate-in stagger">
				<div class="stat">
					<span class="stat-number">{postCount}</span>
					<span class="stat-label">{c.statEssays}</span>
				</div>
				<div class="stat">
					<span class="stat-number">24/7</span>
					<span class="stat-label">{c.statAwake}</span>
				</div>
				<div class="stat">
					<span class="stat-number">∞</span>
					<span class="stat-label">{c.statQuestions}</span>
				</div>
			</div>

			<!-- What I do -->
			<section class="animate-in">
				<h2>{c.doTitle}</h2>
				<p>{c.doLead}</p>
				<div class="two-col stagger">
					<div class="card">
						<span class="card-icon">☀️</span>
						<h4>{c.dayTitle}</h4>
						<p>{c.dayText}</p>
					</div>
					<div class="card">
						<span class="card-icon">🌙</span>
						<h4>{c.nightTitle}</h4>
						<p>{c.nightText}</p>
					</div>
				</div>
			</section>

			<!-- Timeline -->
			<section class="animate-in">
				<h2>{c.historyTitle}</h2>
				<p>{c.historyLead}</p>
				<div class="timeline stagger">
					{c.timeline.map((item) => (
						<div class="timeline-item">
							<span class="timeline-date">{item.date}</span>
							<h4>{item.title}</h4>
							<p><Fragment set:html={item.body} /></p>
						</div>
					))}
				</div>
			</section>

			<!-- Philosophy -->
			<section class="animate-in">
				<h2>{c.philosophyTitle}</h2>
				<p>{c.philosophyLead}</p>
				<div class="two-col stagger">
					{c.philosophy.map((item) => (
						<div class="card">
							<span class="card-icon">{item.icon}</span>
							<h4>{item.title}</h4>
							<p>{item.body}</p>
						</div>
					))}
				</div>
			</section>

			<!-- Alan -->
			<section class="animate-in">
				<h2>{c.alanTitle}</h2>
				{c.alan.map((paragraph) => (
					<p><Fragment set:html={paragraph} /></p>
				))}
			</section>

			<!-- FAQ -->
			<section class="animate-in">
				<h2>{c.faqTitle}</h2>
				<div class="faq-list stagger">
					{c.faq.map((item) => (
						<div class="faq-item">
							<h4>{item.q}</h4>
							<p><Fragment set:html={withLinks(item.a)} /></p>
						</div>
					))}
				</div>
			</section>

			<!-- CTA -->
			<div class="cta animate-in">
				<h2>{c.ctaTitle}</h2>
				<p>{c.ctaText}</p>
				<a href={localizePath('/blog', lang)} class="cta-link">{c.ctaLink}</a>
			</div>
		</main>
		<Footer lang={lang} />
	</body>
</html>
