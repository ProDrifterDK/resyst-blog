---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;
---

<html lang="es">
	<head>
		<BaseHead 
			title={title} 
			description={description}
			ogType="article"
			article={{
				publishedTime: pubDate ? new Date(pubDate).toISOString() : undefined,
				modifiedTime: updatedDate ? new Date(updatedDate).toISOString() : undefined,
				tags: tags || [],
				section: 'Filosofía Digital',
			}}
		/>
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
				background:
					radial-gradient(ellipse at 50% 0%, var(--accent-dim), transparent 34rem),
					linear-gradient(180deg, var(--bg-deep), var(--bg-base) 48%, var(--bg-deep));
				overflow: hidden;
			}

			article {
				position: relative;
				padding-bottom: var(--space-xl);
			}

			article::before {
				content: '';
				position: absolute;
				top: 0;
				left: 50%;
				width: min(54rem, 82vw);
				height: 1px;
				background: linear-gradient(90deg, transparent, var(--border-accent), transparent);
				box-shadow: 0 0 24px var(--accent-glow);
				transform: translateX(-50%);
				pointer-events: none;
			}

			.hero-image {
				width: min(var(--max-width-wide), calc(100% - var(--space-lg)));
				margin: var(--space-lg) auto 0;
				animation: manuscriptRise 0.8s var(--ease-out) both;
			}

			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 0;
				border: 1px solid var(--border-accent);
				box-shadow: var(--shadow-lg), 0 0 60px var(--accent-glow);
			}

			/* Article Container */
			.article-header {
				width: var(--max-width);
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: clamp(var(--space-xl), 8vw, var(--space-2xl)) var(--space-md) var(--space-lg);
				text-align: center;
				animation: manuscriptRise 0.8s var(--ease-out) 80ms both;
			}

			.article-meta {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: var(--space-sm);
				margin-bottom: var(--space-md);
			}

			.article-date {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--accent);
				font-weight: 500;
				letter-spacing: 0.18em;
				text-transform: uppercase;
				text-shadow: 0 0 18px var(--accent-glow);
			}

			.article-updated {
				font-family: var(--font-mono);
				font-size: 0.66rem;
				color: var(--text-muted);
				letter-spacing: 0.1em;
				text-transform: uppercase;
			}

			.article-header h1 {
				font-family: var(--font-serif);
				font-size: clamp(3rem, 8vw, 6.25rem);
				font-weight: 300;
				line-height: 0.92;
				margin: 0 0 var(--space-lg);
				letter-spacing: -0.05em;
				color: var(--text-heading);
				text-wrap: balance;
			}

			/* Tags */
			.article-tags {
				display: flex;
				gap: var(--space-sm);
				flex-wrap: wrap;
				justify-content: center;
				margin-bottom: var(--space-lg);
			}

			.tag-pill {
				display: inline-flex;
				align-items: center;
				background: var(--paper-dim);
				border: 1px solid var(--border);
				color: var(--text-secondary);
				padding: 0.36rem 0.74rem;
				border-radius: 999px;
				font-family: var(--font-mono);
				font-size: 0.68rem;
				font-weight: 500;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				text-decoration: none;
				transition: color var(--transition-base), background var(--transition-base), border-color var(--transition-base), transform var(--transition-base), box-shadow var(--transition-base);
			}

			.tag-pill:hover {
				background: var(--accent);
				border-color: var(--accent);
				color: var(--bg-deep);
				box-shadow: var(--shadow-glow);
				transform: translateY(-2px);
				text-decoration: none;
			}

			/* Prose (the actual content) */
			.prose {
				width: var(--max-width);
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: var(--space-md) var(--space-md) var(--space-2xl);
				font-family: var(--font-sans);
				color: var(--text-primary);
				animation: manuscriptRise 0.8s var(--ease-out) 160ms both;
			}

			.prose h2,
			.prose h3,
			.prose h4 {
				font-family: var(--font-serif);
				font-weight: 400;
				color: var(--text-heading);
				letter-spacing: -0.02em;
				text-wrap: balance;
			}

			.prose h2 {
				font-size: clamp(2rem, 5vw, 3.2rem);
				line-height: 1;
				margin: var(--space-xl) 0 var(--space-md);
				padding-top: var(--space-lg);
				border-top: 1px solid var(--border-accent);
				text-shadow: 0 0 22px color-mix(in srgb, var(--accent-glow) 55%, transparent);
			}

			.prose h3 {
				font-size: clamp(1.55rem, 3vw, 2.2rem);
				margin: var(--space-xl) 0 var(--space-sm);
			}

			.prose h4 {
				font-size: 1.3rem;
				margin: var(--space-lg) 0 var(--space-sm);
			}

			.prose p {
				font-size: 1.04rem;
				line-height: 1.9;
				margin-bottom: var(--space-lg);
			}

			.prose strong {
				color: var(--text-heading);
				font-weight: 600;
			}

			.prose em {
				color: var(--text-secondary);
			}

			.prose a {
				color: var(--accent);
				text-decoration: none;
				background-image: linear-gradient(90deg, var(--accent), var(--accent-hover));
				background-position: 0 100%;
				background-repeat: no-repeat;
				background-size: 100% 1px;
				transition: color var(--transition-fast), background-size var(--transition-base), text-shadow var(--transition-fast);
			}

			.prose a:hover {
				color: var(--accent-hover);
				background-size: 100% 0.18em;
				text-shadow: 0 0 16px var(--accent-glow);
				text-decoration: none;
			}

			.prose blockquote {
				position: relative;
				margin: var(--space-xl) 0;
				padding: clamp(var(--space-lg), 4vw, var(--space-xl));
				border: 1px solid var(--border-accent);
				border-left: 4px solid var(--accent);
				background: var(--paper);
				color: var(--ink);
				box-shadow: var(--shadow-lg), 0 0 0 1px var(--paper-dim);
				overflow: hidden;
			}

			.prose blockquote::before {
				content: '';
				position: absolute;
				inset: var(--space-md);
				border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
				pointer-events: none;
			}

			.prose blockquote::after {
				content: '';
				position: absolute;
				inset: 0;
				background-image: var(--grain);
				opacity: 0.35;
				mix-blend-mode: multiply;
				pointer-events: none;
			}

			.prose blockquote p {
				position: relative;
				z-index: 1;
				font-family: var(--font-serif);
				font-size: clamp(1.25rem, 3vw, 1.75rem);
				font-style: italic;
				color: var(--ink);
				line-height: 1.6;
				margin-bottom: var(--space-sm);
			}

			.prose ul, .prose ol {
				margin-bottom: var(--space-lg);
				padding-left: var(--space-lg);
			}

			.prose li {
				margin-bottom: var(--space-sm);
				line-height: 1.75;
				padding-left: var(--space-xs);
			}

			.prose li::marker {
				color: var(--accent);
			}

			.prose code {
				font-family: var(--font-mono);
				background: var(--paper-dim);
				border: 1px solid var(--border);
				color: var(--accent);
				padding: 0.12em 0.42em;
				border-radius: 4px;
				font-size: 0.88em;
			}

			.prose pre {
				background: linear-gradient(145deg, var(--bg-surface), var(--bg-elevated)) !important;
				border: 1px solid var(--border-accent);
				border-radius: 0;
				padding: var(--space-lg);
				margin: var(--space-xl) 0;
				overflow-x: auto;
				box-shadow: var(--shadow-md), inset 0 1px 0 var(--border-subtle);
			}

			.prose pre code {
				all: unset;
				font-family: var(--font-mono);
				font-size: 0.88em;
				color: var(--text-primary);
				line-height: 1.75;
			}

			.prose hr {
				border: none;
				height: 1px;
				background: linear-gradient(90deg, transparent, var(--border-accent), transparent);
				margin: var(--space-xl) 0;
				box-shadow: 0 0 18px var(--accent-glow);
			}

			.prose img {
				border-radius: 0;
				border: 1px solid var(--border);
				box-shadow: var(--shadow-lg);
				margin: var(--space-xl) 0;
			}

			/* Reading progress feel */
			.article-divider {
				border: none;
				height: 1px;
				background: linear-gradient(90deg, transparent, var(--accent), transparent);
				margin: 0 auto;
				width: min(18rem, 62vw);
				box-shadow: 0 0 18px var(--accent-glow);
			}

			@keyframes manuscriptRise {
				from {
					opacity: 0;
					transform: translateY(var(--space-lg));
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				*, *::before, *::after {
					animation-duration: 1ms !important;
					transition-duration: 1ms !important;
					scroll-behavior: auto !important;
				}
			}

			@media (max-width: 720px) {
				.article-header {
					max-width: calc(100% - var(--space-md));
					padding-top: var(--space-xl);
				}

				.article-header h1 {
					font-size: clamp(2.4rem, 15vw, 4rem);
					line-height: 0.98;
				}

				.prose {
					max-width: calc(100% - var(--space-md));
				}

				.prose p {
					font-size: 1em;
					line-height: 1.82;
				}

				.prose blockquote {
					padding: var(--space-lg);
				}

				.prose pre {
					padding: var(--space-md);
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="article-header">
					<div class="article-meta">
						<span class="article-date">
							<FormattedDate date={pubDate} />
						</span>
						{updatedDate && (
							<span class="article-updated">
								Actualizado: <FormattedDate date={updatedDate} />
							</span>
						)}
					</div>
					<h1>{title}</h1>
					{tags && tags.length > 0 && (
						<div class="article-tags">
							{tags.map((tag: string) => (
								<a href={`/blog/tags/${encodeURIComponent(tag)}/`} class="tag-pill">{tag}</a>
							))}
						</div>
					)}
					<hr class="article-divider" />
				</div>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
