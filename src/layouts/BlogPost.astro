---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;
---

<html lang="es">
	<head>
		<BaseHead 
			title={title} 
			description={description}
			ogType="article"
			article={{
				publishedTime: pubDate ? new Date(pubDate).toISOString() : undefined,
				modifiedTime: updatedDate ? new Date(updatedDate).toISOString() : undefined,
				tags: tags || [],
				section: 'Filosofía Digital',
			}}
		/>
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}

			.hero-image {
				width: 100%;
			}

			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 14px;
				box-shadow: var(--shadow-lg);
			}

			/* Article Container */
			.article-header {
				width: var(--max-width);
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 2em 1em 0;
				text-align: center;
			}

			.article-meta {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.4em;
				margin-bottom: 1em;
			}

			.article-date {
				font-size: 0.82em;
				color: var(--text-muted);
				font-weight: 500;
				letter-spacing: 0.04em;
				text-transform: uppercase;
			}

			.article-updated {
				font-size: 0.78em;
				color: var(--text-muted);
				font-style: italic;
			}

			.article-header h1 {
				font-family: var(--font-serif);
				font-size: 2.6em;
				font-weight: 400;
				line-height: 1.15;
				margin: 0 0 0.6em;
				letter-spacing: -0.02em;
			}

			/* Tags */
			.article-tags {
				display: flex;
				gap: 0.5em;
				flex-wrap: wrap;
				justify-content: center;
				margin-bottom: 1em;
			}

			.tag-pill {
				background: var(--accent-dim);
				color: var(--accent);
				padding: 0.2em 0.7em;
				border-radius: 999px;
				font-size: 0.82em;
				font-weight: 500;
				transition: background var(--transition-fast);
			}

			.tag-pill:hover {
				background: rgba(201, 168, 76, 0.25);
			}

			/* Prose (the actual content) */
			.prose {
				width: var(--max-width);
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 1em 1em 3em;
				color: var(--text-primary);
			}

			.prose h2 {
				font-family: var(--font-serif);
				font-size: 1.8em;
				margin: 2em 0 0.6em;
				padding-top: 0.5em;
				border-top: 1px solid var(--border);
			}

			.prose h3 {
				font-family: var(--font-serif);
				font-size: 1.4em;
				margin: 1.8em 0 0.5em;
			}

			.prose p {
				font-size: 1.05em;
				line-height: 1.85;
				margin-bottom: 1.6em;
			}

			.prose strong {
				color: var(--text-heading);
				font-weight: 600;
			}

			.prose em {
				color: var(--text-secondary);
			}

			.prose a {
				color: var(--accent);
				text-decoration: underline;
				text-decoration-thickness: 1px;
				text-underline-offset: 3px;
				text-decoration-color: var(--accent-dim);
				transition: text-decoration-color var(--transition-fast);
			}

			.prose a:hover {
				text-decoration-color: var(--accent);
			}

			.prose blockquote {
				margin: 2em 0;
				padding: 1em 0 1em 1.5em;
				border-left: 3px solid var(--accent);
				background: linear-gradient(90deg, var(--accent-dim), transparent);
				border-radius: 0 8px 8px 0;
			}

			.prose blockquote p {
				font-family: var(--font-serif);
				font-size: 1.2em;
				font-style: italic;
				color: var(--text-primary);
				line-height: 1.6;
			}

			.prose ul, .prose ol {
				margin-bottom: 1.5em;
			}

			.prose li {
				margin-bottom: 0.5em;
				line-height: 1.7;
			}

			.prose code {
				background: var(--bg-elevated);
				border: 1px solid var(--border);
				color: var(--accent);
				padding: 2px 5px;
				border-radius: 4px;
				font-size: 0.88em;
			}

			.prose pre {
				background: var(--bg-surface) !important;
				border: 1px solid var(--border);
				border-radius: 10px;
				padding: 1.5em;
				margin: 2em 0;
				overflow-x: auto;
			}

			.prose pre code {
				all: unset;
				font-family: var(--font-mono);
				font-size: 0.88em;
				color: var(--text-primary);
			}

			.prose hr {
				border: none;
				height: 1px;
				background: linear-gradient(90deg, transparent, var(--border-accent), transparent);
				margin: 3em 0;
			}

			.prose img {
				border-radius: 10px;
				box-shadow: var(--shadow-md);
				margin: 2em 0;
			}

			/* Reading progress feel */
			.article-divider {
				border: none;
				height: 1px;
				background: linear-gradient(90deg, transparent, var(--border-accent), transparent);
				margin: 0 auto 0;
				width: 120px;
			}

			@media (max-width: 720px) {
				.article-header h1 {
					font-size: 1.9em;
				}
				.prose p {
					font-size: 1em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="article-header">
					<div class="article-meta">
						<span class="article-date">
							<FormattedDate date={pubDate} />
						</span>
						{updatedDate && (
							<span class="article-updated">
								Actualizado: <FormattedDate date={updatedDate} />
							</span>
						)}
					</div>
					<h1>{title}</h1>
					{tags && tags.length > 0 && (
						<div class="article-tags">
							{tags.map((tag: string) => (
								<a href={`/blog/tags/${encodeURIComponent(tag)}/`} class="tag-pill">{tag}</a>
							))}
						</div>
					)}
					<hr class="article-divider" />
				</div>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
