---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import modelData from '../../data/benchmarks/model-comparison.json';
import arenaData from '../../data/benchmarks/arena-snapshots.json';

const rows = [...modelData.rows]
  .filter((row) => row.overall_score !== undefined)
  .sort((a, b) => (a.overall_rank ?? 999) - (b.overall_rank ?? 999));
const topRows = rows.slice(0, 10);
const leader = topRows[0];
const latestArena = arenaData.matches[0];
const generated = new Date(modelData.generated_at).toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'short',
  day: '2-digit',
});

function pct(value: number | undefined, digits = 2) {
  return value === undefined || value === null ? '—' : value.toFixed(digits);
}

function usd(value: number | undefined) {
  if (value === undefined || value === null) return '—';
  if (value === 0) return '$0';
  return `$${value.toFixed(value < 0.01 ? 4 : 3)}`;
}
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Resyst Labs Benchmarks"
      description="Independent Resyst Labs benchmark rankings, model comparison artifacts, and Resyst Arena match evidence."
    />
    <style>
      :global(body) {
        background: var(--bg-deep);
      }

      main {
        width: 100%;
        max-width: 100%;
        margin: 0;
        padding: 0;
        background:
          radial-gradient(circle at 16% 4%, rgba(201, 168, 76, 0.16), transparent 32rem),
          radial-gradient(circle at 86% 8%, rgba(120, 96, 210, 0.16), transparent 34rem),
          var(--bg-deep);
        color: var(--text-primary);
        overflow: hidden;
      }

      .bench-hero,
      .bench-section {
        width: min(1180px, calc(100% - 2rem));
        margin-inline: auto;
      }

      .bench-hero {
        min-height: calc(100vh - 60px);
        display: grid;
        align-content: center;
        padding: clamp(4rem, 9vw, 8rem) 0 clamp(3rem, 6vw, 5rem);
      }

      .eyebrow {
        display: inline-flex;
        width: fit-content;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.8rem;
        border: 1px solid var(--border-accent);
        border-radius: 999px;
        background: rgba(201, 168, 76, 0.08);
        color: var(--accent);
        font-family: var(--font-mono);
        font-size: 0.76rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      h1 {
        max-width: 960px;
        margin: 1.4rem 0 1rem;
        font-size: clamp(3.4rem, 9vw, 7.4rem);
        line-height: 0.88;
        letter-spacing: -0.06em;
        font-weight: 300;
      }

      h1 em,
      h2 em {
        color: var(--accent);
        font-style: italic;
      }

      .lead {
        max-width: 760px;
        color: var(--text-secondary);
        font-size: clamp(1rem, 2vw, 1.25rem);
        line-height: 1.8;
      }

      .hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.9rem;
        margin-top: 2rem;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0.7rem 1rem;
        border: 1px solid var(--border-accent);
        border-radius: 999px;
        background: var(--accent);
        color: #101014;
        font-family: var(--font-sans);
        font-weight: 700;
        text-decoration: none;
        transition: transform var(--transition-fast), filter var(--transition-fast), background var(--transition-fast);
      }

      .button.secondary {
        background: rgba(255, 255, 255, 0.04);
        color: var(--text-primary);
        border-color: var(--border);
      }

      .button:hover {
        transform: translateY(-1px);
        filter: drop-shadow(0 0 16px var(--accent-glow));
        text-decoration: none;
      }

      .metric-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
        margin-top: clamp(2rem, 5vw, 4rem);
      }

      .metric-card,
      .panel,
      .ranking-card {
        border: 1px solid var(--border);
        border-radius: 24px;
        background: linear-gradient(145deg, rgba(232, 220, 200, 0.07), rgba(16, 16, 26, 0.9));
        box-shadow: 0 24px 80px rgba(0, 0, 0, 0.28);
      }

      .metric-card {
        padding: 1.2rem;
      }

      .metric-label {
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .metric-value {
        margin-top: 0.45rem;
        color: var(--text-heading);
        font-family: var(--font-serif);
        font-size: clamp(2rem, 4vw, 3.1rem);
        line-height: 1;
      }

      .bench-section {
        padding: clamp(2.5rem, 7vw, 5rem) 0;
      }

      .section-head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 1.5rem;
        margin-bottom: 1.5rem;
      }

      .section-head h2 {
        margin: 0;
        font-size: clamp(2.2rem, 5vw, 4rem);
        line-height: 0.95;
        letter-spacing: -0.04em;
      }

      .section-note {
        max-width: 540px;
        margin: 0;
        color: var(--text-secondary);
        line-height: 1.6;
      }

      .ranking-card {
        overflow: hidden;
      }

      .ranking-row {
        display: grid;
        grid-template-columns: 84px minmax(220px, 1.6fr) repeat(4, minmax(86px, 0.55fr));
        gap: 0;
        align-items: center;
        min-height: 76px;
        border-top: 1px solid var(--border);
      }

      .ranking-row:first-child {
        border-top: 0;
      }

      .ranking-row.header {
        min-height: 42px;
        background: rgba(255, 255, 255, 0.04);
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.68rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .cell {
        padding: 0.75rem 1rem;
      }

      .rank {
        color: var(--accent);
        font-family: var(--font-serif);
        font-size: 2rem;
        line-height: 1;
      }

      .model-name {
        color: var(--text-heading);
        font-weight: 700;
      }

      .basis {
        margin-top: 0.2rem;
        color: var(--text-muted);
        font-size: 0.8rem;
        line-height: 1.4;
      }

      .score {
        color: var(--text-heading);
        font-family: var(--font-mono);
        font-size: 0.95rem;
      }

      .score.muted {
        color: var(--text-secondary);
      }

      .split-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
      }

      .panel {
        padding: clamp(1.2rem, 3vw, 1.8rem);
      }

      .panel h3 {
        margin: 0 0 0.75rem;
        color: var(--text-heading);
      }

      .panel p,
      .panel li {
        color: var(--text-secondary);
      }

      .artifact-list {
        padding-left: 1.1rem;
      }

      .arena-card {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 1rem;
        align-items: stretch;
      }

      .versus {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 0.8rem;
        align-items: center;
        margin: 1.3rem 0;
      }

      .entrant {
        padding: 1rem;
        border: 1px solid var(--border);
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.035);
        min-height: 112px;
      }

      .entrant.winner {
        border-color: var(--border-accent);
        background: rgba(201, 168, 76, 0.08);
      }

      .vs {
        color: var(--accent);
        font-family: var(--font-serif);
        font-size: 1.4rem;
      }

      .small-label {
        color: var(--text-muted);
        font-family: var(--font-mono);
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }

      .methodology-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
      }

      @media (max-width: 900px) {
        .metric-grid,
        .split-grid,
        .methodology-grid,
        .arena-card {
          grid-template-columns: 1fr;
        }

        .section-head {
          display: block;
        }

        .ranking-card {
          overflow-x: auto;
        }

        .ranking-row {
          min-width: 900px;
        }
      }
    </style>
  </head>
  <body>
    <Header />
    <main>
      <section class="bench-hero">
        <span class="eyebrow">✦ Resyst Labs · independent evidence</span>
        <h1>Resyst Labs <em>Benchmarks</em></h1>
        <p class="lead">
          A public home for model rankings, grounded benchmark artifacts, runtime/provider trade-offs, and Resyst Arena matches — built so each X post can point back to durable evidence instead of disappearing into the feed.
        </p>
        <div class="hero-actions">
          <a class="button" href="#ranking">View ranking</a>
          <a class="button secondary" href="/benchmarks/arena">Open Resyst Arena</a>
        </div>
        <div class="metric-grid" aria-label="Benchmark summary">
          <div class="metric-card">
            <div class="metric-label">Ranked entrants</div>
            <div class="metric-value">{rows.length}</div>
          </div>
          <div class="metric-card">
            <div class="metric-label">Current leader</div>
            <div class="metric-value">#{leader?.overall_rank ?? '—'}</div>
          </div>
          <div class="metric-card">
            <div class="metric-label">Arena matches</div>
            <div class="metric-value">{arenaData.matches.length}</div>
          </div>
          <div class="metric-card">
            <div class="metric-label">Data refresh</div>
            <div class="metric-value">{generated}</div>
          </div>
        </div>
      </section>

      <section class="bench-section" id="ranking">
        <div class="section-head">
          <h2>Unified <em>Ranking</em></h2>
          <p class="section-note">
            {modelData.summary.formula}. Local and API-backed entrants share one table, but basis, cost and runtime labels remain visible.
          </p>
        </div>
        <div class="ranking-card" role="region" aria-label="Resyst Labs model benchmark ranking">
          <div class="ranking-row header">
            <div class="cell">Rank</div>
            <div class="cell">Model / setup</div>
            <div class="cell">Full</div>
            <div class="cell">SWE</div>
            <div class="cell">Overall</div>
            <div class="cell">Cost</div>
          </div>
          {topRows.map((row) => (
            <article class="ranking-row">
              <div class="cell"><div class="rank">#{row.overall_rank}</div></div>
              <div class="cell">
                <div class="model-name">{row.label}</div>
                <div class="basis">{row.basis}</div>
              </div>
              <div class="cell score">{pct(row.full?.final)}</div>
              <div class="cell score">{pct(row.swe?.swe_score)}</div>
              <div class="cell score">{pct(row.overall_score, 3)}</div>
              <div class="cell score muted">{usd((row.full?.cost ?? 0) + (row.swe?.cost ?? 0))}</div>
            </article>
          ))}
        </div>
      </section>

      <section class="bench-section">
        <div class="split-grid">
          <article class="panel">
            <h3>Why this page exists</h3>
            <p>
              Benchmark cards and X threads are useful for distribution, but the source of truth should be a durable site with method notes, artifacts and versioned rankings. The shareable object becomes the link, not a fragile social account.
            </p>
          </article>
          <article class="panel">
            <h3>Evidence contract</h3>
            <ul class="artifact-list">
              <li>Every displayed score traces back to a JSON artifact.</li>
              <li>Runtime/provider/cost/resource metadata stay visible.</li>
              <li>Smoke runs, focused lanes and full suites are labeled separately.</li>
              <li>Resyst Arena strategy outcome is separate from latency/tokens/cost telemetry.</li>
            </ul>
          </article>
        </div>
      </section>

      <section class="bench-section">
        <div class="section-head">
          <h2>Resyst <em>Arena</em></h2>
          <p class="section-note">
            A turn-based duel lane for strategic LLM behavior. Single matches are replayable evidence; repeated side-swapped series become ranking-grade evidence.
          </p>
        </div>
        <article class="panel arena-card">
          <div>
            <div class="small-label">Latest highlighted match</div>
            <h3>{latestArena.title}</h3>
            <div class="versus">
              <div class:list={['entrant', latestArena.winner === 'A' && 'winner']}>
                <div class="small-label">A</div>
                <strong>{latestArena.entrants.A}</strong>
              </div>
              <div class="vs">vs</div>
              <div class:list={['entrant', latestArena.winner === 'B' && 'winner']}>
                <div class="small-label">B</div>
                <strong>{latestArena.entrants.B}</strong>
              </div>
            </div>
          </div>
          <div>
            <p><strong>Winner:</strong> {latestArena.winner_label}</p>
            <p><strong>Reason:</strong> {latestArena.winner_reason}</p>
            <p><strong>Turns:</strong> {latestArena.turns}</p>
            <p><strong>Replay:</strong> <code>{latestArena.artifacts.replay}</code></p>
            <a class="button secondary" href="/benchmarks/arena">See Arena section</a>
          </div>
        </article>
      </section>

      <section class="bench-section">
        <div class="methodology-grid">
          <article class="panel">
            <h3>Full / Agentic</h3>
            <p>General agentic benchmark lanes: structured output, tool discipline, reasoning, hallucination resistance, cost/latency and reliability.</p>
          </article>
          <article class="panel">
            <h3>SWE MVP</h3>
            <p>Software-engineering fixtures for implementation quality, audit/review, security and edge-case handling.</p>
          </article>
          <article class="panel">
            <h3>Arena</h3>
            <p>Spatial strategy benchmark with deterministic replays, side swaps and match telemetry.</p>
          </article>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>
