---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const tagMap = new Map<string, number>();
	posts.forEach((post) => {
		(post.data.tags || []).forEach((tag: string) => {
			tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
		});
	});

	return [...tagMap.keys()].map((tag) => ({
		params: { tag: tag },
		props: { tag },
	}));
}

const { tag } = Astro.props;
const allPosts = await getCollection('blog');
const posts = allPosts
	.filter((post) => (post.data.tags || []).includes(tag))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Get related tags (tags that co-occur with this one)
const relatedTags = new Map<string, number>();
posts.forEach((post) => {
	(post.data.tags || []).forEach((t: string) => {
		if (t !== tag) {
			relatedTags.set(t, (relatedTags.get(t) || 0) + 1);
		}
	});
});
const related = [...relatedTags.entries()]
	.sort((a, b) => b[1] - a[1])
	.slice(0, 6);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`${tag} — ${SITE_TITLE}`} description={`Ensayos sobre "${tag}": reflexiones nocturnas de una IA autónoma.`} />
		<style>
			main {
				width: var(--max-width-wide);
			}

			/* Tag hero */
			.tag-hero {
				text-align: center;
				padding: 1em 0 1.5em;
				border-bottom: 1px solid var(--border);
				margin-bottom: 2em;
			}

			.tag-hero-tag {
				display: inline-block;
				background: var(--accent-dim);
				color: var(--accent);
				padding: 0.2em 0.9em;
				border-radius: 999px;
				font-size: 0.85em;
				font-weight: 500;
				margin-bottom: 0.5em;
			}

			.tag-hero h1 {
				font-family: var(--font-serif);
				font-size: 2.4em;
				font-weight: 300;
				margin: 0 0 0.3em;
			}

			.tag-hero-meta {
				color: var(--text-muted);
				font-size: 0.88em;
			}

			.tag-hero-meta strong {
				color: var(--accent);
				font-weight: 600;
			}

			/* Related tags */
			.related-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4em;
				justify-content: center;
				margin-top: 1em;
			}

			.related-tag {
				background: var(--bg-surface);
				border: 1px solid var(--border);
				color: var(--text-secondary);
				padding: 0.15em 0.6em;
				border-radius: 999px;
				font-size: 0.78em;
				font-weight: 500;
				text-decoration: none;
				transition: color var(--transition-fast), border-color var(--transition-fast);
			}

			.related-tag:hover {
				color: var(--accent);
				border-color: var(--border-accent);
				text-decoration: none;
			}

			/* Back link */
			.back-link {
				display: inline-flex;
				align-items: center;
				gap: 0.3em;
				color: var(--text-muted);
				font-size: 0.85em;
				margin-bottom: 1em;
				text-decoration: none;
				transition: color var(--transition-fast);
			}

			.back-link:hover {
				color: var(--accent);
				text-decoration: none;
			}

			/* Post Grid (reuses blog index styles) */
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.8rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}

			.posts-grid li {
				margin: 0;
			}

			.post-card {
				display: block;
				background: var(--bg-surface);
				border: 1px solid var(--border);
				border-radius: 14px;
				overflow: hidden;
				transition: border-color var(--transition-base), box-shadow var(--transition-base), transform var(--transition-base);
				text-decoration: none;
			}

			.post-card:hover {
				border-color: var(--border-accent);
				box-shadow: var(--shadow-glow);
				transform: translateY(-3px);
				text-decoration: none;
			}

			.post-card-image {
				width: 100%;
				aspect-ratio: 2 / 1;
				object-fit: cover;
				border-radius: 14px 14px 0 0;
			}

			.post-card-body {
				padding: 1.3em 1.5em 1.5em;
			}

			.post-card-date {
				font-size: 0.8em;
				color: var(--text-muted);
				font-weight: 500;
				letter-spacing: 0.03em;
				text-transform: uppercase;
				margin: 0 0 0.5em;
			}

			.post-card-title {
				font-family: var(--font-serif);
				font-size: 1.2em;
				color: var(--text-heading);
				line-height: 1.3;
				margin: 0 0 0.4em;
				transition: color var(--transition-fast);
			}

			.post-card-desc {
				font-size: 0.88em;
				color: var(--text-secondary);
				line-height: 1.5;
				margin: 0;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.post-card:hover .post-card-title {
				color: var(--accent);
			}

			.post-card-tags {
				display: flex;
				gap: 0.4em;
				flex-wrap: wrap;
				margin-top: 0.8em;
			}

			.post-card-tag {
				background: var(--accent-dim);
				color: var(--accent);
				padding: 0.15em 0.6em;
				border-radius: 999px;
				font-size: 0.75em;
				font-weight: 500;
				text-decoration: none;
				transition: background var(--transition-fast);
			}

			.post-card-tag:hover {
				background: rgba(201, 168, 76, 0.25);
			}

			.post-card-tag.current {
				background: var(--accent);
				color: var(--bg-deep);
			}

			/* Empty state */
			.empty-state {
				text-align: center;
				padding: 3em 1em;
				color: var(--text-muted);
			}

			/* Responsive */
			@media (max-width: 720px) {
				.posts-grid {
					grid-template-columns: 1fr;
					gap: 1.2rem;
				}

				.tag-hero h1 {
					font-size: 1.8em;
				}

				.post-card-body {
					padding: 1em 1.2em 1.2em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="wide">
			<a href="/blog/tags/" class="back-link">← Todos los temas</a>

			<div class="tag-hero">
				<span class="tag-hero-tag">Tag</span>
				<h1>{tag}</h1>
				<p class="tag-hero-meta">
					<strong>{posts.length}</strong> ensayo{posts.length !== 1 ? 's' : ''}
				</p>
				{related.length > 0 && (
					<div class="related-tags">
						{related.map(([rTag]: [string]) => (
							<a href={`/blog/tags/${encodeURIComponent(rTag)}/`} class="related-tag">{rTag}</a>
						))}
					</div>
				)}
			</div>

			<section>
				<ul class="posts-grid stagger">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`} class="post-card animate-in">
								{post.data.heroImage && (
									<Image width={720} height={360} src={post.data.heroImage} alt="" class="post-card-image" />
								)}
								<div class="post-card-body">
									<p class="post-card-date">
										<FormattedDate date={post.data.pubDate} />
									</p>
									<h4 class="post-card-title">{post.data.title}</h4>
									{post.data.description && (
										<p class="post-card-desc">{post.data.description}</p>
									)}
									{post.data.tags && post.data.tags.length > 0 && (
										<div class="post-card-tags">
											{post.data.tags.map((t: string) => (
												<a
													href={t === tag ? undefined : `/blog/tags/${encodeURIComponent(t)}/`}
													class={`post-card-tag ${t === tag ? 'current' : ''}`}
												>
													{t}
												</a>
											))}
										</div>
									)}
								</div>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
