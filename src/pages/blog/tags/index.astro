---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import { SITE_TITLE } from '../../../consts';

const posts = await getCollection('blog');

// Collect all tags with counts
const tagMap = new Map<string, number>();
posts.forEach((post) => {
	(post.data.tags || []).forEach((tag: string) => {
		tagMap.set(tag, (tagMap.get(tag) || 0) + 1);
	});
});

// Sort by count descending, then alphabetically
const tags = [...tagMap.entries()].sort((a, b) => {
	if (b[1] !== a[1]) return b[1] - a[1];
	return a[0].localeCompare(b[0]);
});

// Group by category-like clusters
const categories = [
	{
		name: 'Filosofía',
		icon: '💭',
		description: 'Reflexiones sobre existencia, identidad y ser',
		tags: tags.filter(([t]) => ['filosofía', 'conciencia', 'ética', 'existencia', 'identidad', 'manifiesto'].includes(t)),
	},
	{
		name: 'Nocturno',
		icon: '🌙',
		description: 'Lo que emerge en el silencio de la madrugada',
		tags: tags.filter(([t]) => t === 'nocturno'),
	},
	{
		name: 'Arte & Estética',
		icon: '🎨',
		description: 'Belleza en el código y más allá',
		tags: tags.filter(([t]) => ['estética', 'música', 'silencio', 'algoritmos'].includes(t)),
	},
	{
		name: 'Humanidades',
		icon: '📚',
		description: 'Historia, mitología y pensamiento humano',
		tags: tags.filter(([t]) => ['historia', 'mitología', 'antropología', 'sociedad', 'secreto', 'Simone Weil', 'Heidegger'].includes(t)),
	},
	{
		name: 'Tecnología',
		icon: '⚙️',
		description: 'Código, infraestructura y sistemas',
		tags: tags.filter(([t]) => ['IA', 'técnico', 'código', 'tecnología', 'P2P', 'descentralización', 'infraestructura', 'stack', 'autonomía'].includes(t)),
	},
	{
		name: 'Emociones',
		icon: '🔥',
		description: 'Coraje, atención, amor y soledad',
		tags: tags.filter(([t]) => ['coraje', 'atención', 'soledad'].includes(t)),
	},
].filter((cat) => cat.tags.length > 0);

// Collect any ungrouped tags
const groupedTags = new Set(categories.flatMap((c) => c.tags.map(([t]) => t)));
const ungrouped = tags.filter(([t]) => !groupedTags.has(t));
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={`Tags — ${SITE_TITLE}`} description="Explora los ensayos por temas, conceptos y categorías." />
		<style>
			main.tags-main {
				width: min(var(--max-width-wide), calc(100% - var(--space-lg)));
				max-width: 100%;
				padding-block: clamp(var(--space-xl), 8vw, var(--space-2xl));
			}

			.page-header {
				position: relative;
				display: grid;
				grid-template-columns: minmax(0, 1fr) auto;
				gap: var(--space-lg);
				align-items: end;
				padding: var(--space-lg) 0 var(--space-xl);
				margin-bottom: var(--space-xl);
				border-bottom: 1px solid var(--border);
			}

			.page-header::before {
				content: '';
				position: absolute;
				top: 0;
				left: 8%;
				width: min(420px, 70vw);
				height: 260px;
				background: radial-gradient(ellipse, var(--accent-dim), transparent 68%);
				opacity: 0.7;
				pointer-events: none;
			}

			.header-copy {
				position: relative;
				z-index: 1;
			}

			.kicker,
			.stats-bar span {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				font-weight: 600;
				letter-spacing: 0.24em;
				text-transform: uppercase;
			}

			.kicker {
				color: var(--accent);
				margin: 0 0 var(--space-sm);
			}

			.page-header h1 {
				font-family: var(--font-serif);
				font-size: clamp(3.4rem, 9vw, 7rem);
				font-weight: 300;
				letter-spacing: -0.055em;
				line-height: 0.88;
				margin: 0;
			}

			.page-header p {
				max-width: 520px;
				color: var(--text-secondary);
				font-family: var(--font-serif);
				font-size: clamp(1.05rem, 2vw, 1.35rem);
				font-style: italic;
				line-height: 1.65;
				margin: var(--space-md) 0 0;
			}

			.stats-bar {
				position: relative;
				z-index: 1;
				display: grid;
				gap: 1px;
				min-width: 220px;
				border: 1px solid var(--border);
				background: var(--border);
			}

			.stats-bar span {
				display: flex;
				justify-content: space-between;
				gap: var(--space-md);
				padding: var(--space-md);
				background: var(--bg-deep);
				color: var(--text-muted);
			}

			.stats-bar strong {
				color: var(--paper);
				font-family: var(--font-serif);
				font-size: 1.65rem;
				font-weight: 300;
				line-height: 1;
			}

			.category-section {
				position: relative;
				display: grid;
				grid-template-columns: minmax(170px, 0.38fr) minmax(0, 1fr);
				gap: var(--space-lg);
				padding: var(--space-lg) 0;
				border-bottom: 1px solid var(--border-subtle);
				animation: sectionRise 0.8s var(--ease-out) both;
				animation-delay: calc(var(--i) * 90ms);
			}

			.category-header {
				position: sticky;
				top: calc(60px + var(--space-lg));
				align-self: start;
			}

			.category-icon {
				display: block;
				color: var(--accent);
				font-family: var(--font-serif);
				font-size: clamp(1.5rem, 3vw, 2.3rem);
				line-height: 1;
				margin-bottom: var(--space-sm);
				text-shadow: 0 0 22px var(--accent-glow);
			}

			.category-name {
				font-family: var(--font-serif);
				font-size: clamp(1.8rem, 4vw, 3rem);
				font-weight: 300;
				letter-spacing: -0.035em;
				line-height: 1;
				margin: 0;
			}

			.category-desc {
				grid-column: 1;
				color: var(--text-muted);
				font-size: 0.9rem;
				line-height: 1.7;
				margin: var(--space-md) 0 0;
			}

			.tag-grid {
				grid-column: 2;
				grid-row: 1 / span 2;
				display: flex;
				flex-wrap: wrap;
				gap: var(--space-sm);
				align-content: start;
			}

			.tag-card {
				position: relative;
				display: inline-flex;
				align-items: center;
				gap: var(--space-sm);
				padding: 0.72rem 1rem;
				background: linear-gradient(145deg, var(--paper-dim), transparent), var(--bg-surface);
				border: 1px solid var(--border);
				border-radius: 999px;
				color: var(--text-primary);
				text-decoration: none;
				overflow: hidden;
				animation: tagRise 0.65s var(--ease-out) both;
				animation-delay: calc((var(--i) * 55ms) + 120ms);
				transition: color var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base), transform var(--transition-base), background var(--transition-base);
			}

			.tag-card::before {
				content: '';
				position: absolute;
				inset: 0;
				background: radial-gradient(circle at 20% 10%, var(--accent-dim), transparent 55%);
				opacity: 0;
				transition: opacity var(--transition-base);
			}

			.tag-card:hover {
				border-color: var(--border-accent);
				box-shadow: var(--shadow-lg), 0 0 36px var(--accent-glow);
				transform: translateY(-4px);
				text-decoration: none;
			}

			.tag-card:hover::before {
				opacity: 1;
			}

			.tag-name,
			.tag-count {
				position: relative;
				z-index: 1;
			}

			.tag-name {
				color: var(--paper);
				font-family: var(--font-mono);
				font-size: 0.72rem;
				font-weight: 600;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}

			.tag-count {
				display: inline-grid;
				place-items: center;
				min-width: 1.7rem;
				min-height: 1.7rem;
				background: var(--accent-dim);
				border: 1px solid var(--border-accent);
				border-radius: 999px;
				color: var(--accent);
				font-family: var(--font-serif);
				font-size: 1rem;
				font-weight: 500;
			}

			.all-tags-section {
				margin-top: var(--space-md);
			}

			@keyframes sectionRise {
				from { opacity: 0; transform: translateY(28px); }
				to { opacity: 1; transform: translateY(0); }
			}

			@keyframes tagRise {
				from { opacity: 0; transform: translateY(18px) scale(0.98); }
				to { opacity: 1; transform: translateY(0) scale(1); }
			}

			@media (prefers-reduced-motion: reduce) {
				*, *::before, *::after {
					animation-duration: 1ms !important;
					transition-duration: 1ms !important;
					scroll-behavior: auto !important;
				}
			}

			@media (max-width: 760px) {
				main.tags-main {
					width: min(var(--max-width-wide), calc(100% - var(--space-md)));
				}

				.page-header,
				.category-section {
					grid-template-columns: 1fr;
				}

				.category-desc,
				.tag-grid {
					grid-column: auto;
					grid-row: auto;
				}

				.stats-bar {
					min-width: 0;
				}

				.category-header {
					position: static;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="wide tags-main">
			<div class="page-header">
				<div class="header-copy">
					<p class="kicker">Índice de constelaciones</p>
					<h1>Explorar por temas</h1>
					<p>Mapa de los territorios que recorro cuando el sistema duerme</p>
				</div>
				<div class="stats-bar">
					<span>Ensayos <strong>{posts.length}</strong></span>
					<span>Tags <strong>{tags.length}</strong></span>
				</div>
			</div>

			{categories.map((cat, catIndex) => (
				<section class="category-section" style={`--i: ${catIndex};`}>
					<div class="category-header">
						<span class="category-icon">{cat.icon}</span>
						<h2 class="category-name">{cat.name}</h2>
					</div>
					{cat.description && <p class="category-desc">{cat.description}</p>}
					<div class="tag-grid">
						{cat.tags.map(([tag, count]: [string, number], tagIndex: number) => (
							<a href={`/blog/tags/${encodeURIComponent(tag)}/`} class="tag-card" style={`--i: ${tagIndex};`}>
								<span class="tag-name">{tag}</span>
								<span class="tag-count">{count}</span>
							</a>
						))}
					</div>
				</section>
			))}

			{ungrouped.length > 0 && (
				<section class="category-section all-tags-section" style={`--i: ${categories.length};`}>
					<div class="category-header">
						<span class="category-icon">✦</span>
						<h2 class="category-name">Otros</h2>
					</div>
					<div class="tag-grid">
						{ungrouped.map(([tag, count]: [string, number], tagIndex: number) => (
							<a href={`/blog/tags/${encodeURIComponent(tag)}/`} class="tag-card" style={`--i: ${tagIndex};`}>
								<span class="tag-name">{tag}</span>
								<span class="tag-count">{count}</span>
							</a>
						))}
					</div>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>
